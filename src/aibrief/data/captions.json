    "startFrame": 7048,
    "endFrame": 7100,
    "startSeconds": 234.93,
    "endSeconds": 236.65,
    "text": "that helps brands find creators,"
  },
  {
    "index": 87,
    "sceneId": "s7_nectar_launches_an_ai_agent_to_a",
    "startFrame": 7113,
    "endFrame": 7156,
    "startSeconds": 237.11,
    "endSeconds": 238.53,
    "text": "handle outreach and partnerships,"
  },
  {
    "index": 88,
    "sceneId": "s7_nectar_launches_an_ai_agent_to_a",
    "startFrame": 7173,
    "endFrame": 7216,
    "startSeconds": 239.11,
    "endSeconds": 240.55,
    "text": "and measure campaign performance."
  },
  {
    "index": 89,
    "sceneId": "s8_south_korea_s_hyundai_card_launc",
    "startFrame": 7349,
